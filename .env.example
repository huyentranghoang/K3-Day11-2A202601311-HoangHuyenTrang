# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên GitHub.

# OpenRouter — lấy key tại https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Model free (KHÔNG thêm dấu nháy quanh giá trị)
LLM_MODEL=nvidia/nemotron-nano-9b-v2:free

# Tuỳ chọn: danh sách fallback (cách nhau bởi dấu phẩy)
# LLM_FALLBACKS=google/gemma-4-26b-a4b-it:free,inclusionai/ling-3.0-tiny:free,openrouter/free
